APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# IP reverse proxy yang dipercaya (pisahkan dengan koma, mis. 127.0.0.1,10.0.0.5
# atau * untuk semua — hanya jika tahu risikonya). Kosong di lokal.
# Wajib diisi di produksi bila aplikasi berada di belakang nginx/Cloudflare,
# agar IP visitor (rate limit, log) terbaca dengan benar.
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Belibayar adalah satu-satunya gateway; jangan aktifkan checkout sebelum sandbox tervalidasi.
BELIBAYAR_MODE=sandbox
BELIBAYAR_BASE_URL=https://api.belibayar.id
BELIBAYAR_API_KEY=
BELIBAYAR_SECRET_KEY=
BELIBAYAR_WEBHOOK_SECRET=
BELIBAYAR_MERCHANT_ID=
# Set callback URL https://domain-anda/webhook/belibayar pada dashboard Belibayar.
# Whitelist IP keluar server di dashboard sebelum pengujian API.

DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_BASE_URL=https://api.digiflazz.com/v1
DIGIFLAZZ_TESTING=false
SUPPLIER=digiflazz

FONNTE_TOKEN=
FONNTE_BASE_URL=https://api.fonnte.com

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://topup.kidbomba.space/auth/google/callback
DIGIFLAZZ_WEBHOOK_SECRET=
DIGIFLAZZ_WEBHOOK_ID=
