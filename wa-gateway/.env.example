# CAPTSHOP WhatsApp gateway — example environment.
#
# Copy to .env (gitignored) or export these in the process manager.
# Never commit a real key.

# Shared secret Laravel sends as X-Internal-Key. Required, minimum 16 chars.
# Generate with: openssl rand -hex 32
WHATSAPP_GATEWAY_KEY=

# Bind address. MUST be loopback (127.0.0.1, ::1 or localhost). There is no
# opt-out: the gateway is a localhost-only service and refuses any other host.
WHATSAPP_GATEWAY_HOST=127.0.0.1
WHATSAPP_GATEWAY_PORT=3213

# SQLite file holding the outbox AND the Baileys auth session.
# Must be outside any webroot. The parent directory is created with mode 0700
# and the file is chmod'd to 0600 on open.
WHATSAPP_GATEWAY_DB=./data/gateway.db

# Delivery retry policy: attempts cap and bounded exponential backoff.
WHATSAPP_GATEWAY_MAX_ATTEMPTS=8
WHATSAPP_GATEWAY_RETRY_BASE_MS=2000
WHATSAPP_GATEWAY_RETRY_MAX_MS=300000
WHATSAPP_GATEWAY_RETRY_JITTER=0.2

# Outbox worker polling interval and stale-claim recovery window.
WHATSAPP_GATEWAY_WORKER_INTERVAL_MS=500
WHATSAPP_GATEWAY_STALE_CLAIM_MS=120000

# Baileys socket reconnect backoff.
WHATSAPP_GATEWAY_RECONNECT_BASE_MS=2000
WHATSAPP_GATEWAY_RECONNECT_MAX_MS=60000

# silent | error | warn | info | debug
WHATSAPP_GATEWAY_LOG_LEVEL=info
