{
  "name": "captshop-wa-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Localhost-only WhatsApp gateway (Baileys + SQLite outbox) for CAPTSHOP transactional messages",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "main": "dist/src/index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build",
    "test": "node --test test/*.test.ts",
    "prestart": "npm run build",
    "start": "node dist/src/index.js",
    "prepair": "npm run build",
    "pair": "node dist/src/cli/pair.js",
    "prestatus": "npm run build",
    "status": "node dist/src/cli/status.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "better-sqlite3": "^13.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "typescript": "^7.0.2"
  }
}
